#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = GROUP) in;
#include "math.glsl"
layout(push_constant) uniform P { In x; Buf y; uint n; uint op; } p;
void main() {
    uint i = gid();
    if (i < p.n) STORE(p.y, i, unary_op(p.op, LOAD(p.x, i)));
}
