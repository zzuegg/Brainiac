#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = GROUP) in;
// Fourier transforms of rows of n complex values (n a power of two, at most MAX_N), one work
// group per row: loaded in bit-reversed order into shared memory, then log2(n) radix-2
// stages. Values are (real, imaginary) pairs; results are float32, the inverse divided by n.
#define MAX_N 2048
layout(push_constant) uniform P { In x; Floats y; uint rows; uint n; uint bits; uint inverse; } p;
shared vec2 v[MAX_N];
void main() {
    uint r = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (r >= p.rows) return;
    uint lid = gl_LocalInvocationID.x;
    uint base = r * p.n * 2;
    for (uint j = lid; j < p.n; j += GROUP) {
        uint rev = p.bits == 0 ? 0 : bitfieldReverse(j) >> (32 - p.bits);
        v[rev] = vec2(float(LOAD(p.x, base + 2 * j)), float(LOAD(p.x, base + 2 * j + 1)));
    }
    barrier();
    float sign = p.inverse != 0 ? 1.0 : -1.0;
    for (uint half_ = 1; half_ < p.n; half_ <<= 1) {
        for (uint t = lid; t < p.n / 2; t += GROUP) {
            uint k = t & (half_ - 1);
            uint i = (t - k) * 2 + k;
            uint j = i + half_;
            float a = sign * 3.14159265358979 * float(k) / float(half_);
            vec2 w = vec2(cos(a), sin(a));
            vec2 b = v[j];
            vec2 x = vec2(b.x * w.x - b.y * w.y, b.x * w.y + b.y * w.x);
            vec2 u = v[i];
            v[i] = u + x;
            v[j] = u - x;
        }
        barrier();
    }
    float scale = p.inverse != 0 ? 1.0 / float(p.n) : 1.0;
    for (uint j = lid; j < p.n; j += GROUP) {
        p.y.v[base + 2 * j] = v[j].x * scale;
        p.y.v[base + 2 * j + 1] = v[j].y * scale;
    }
}
