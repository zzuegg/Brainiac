#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = GROUP) in;
#include "math.glsl"
// Up to 6 axes (the host merges axes and splits higher ranks into several dispatches);
// strides may be 0 to broadcast.
layout(push_constant) uniform P {
    In a; In b; Floats z;
    uint n; uint op; uint rank; uint aOff; uint bOff;
    uint shape[6]; int as_[6]; int bs[6];
} p;
void main() {
    uint i = gid();
    if (i >= p.n) return;
    uint rest = i;
    int ia = int(p.aOff);
    int ib = int(p.bOff);
    for (int d = int(p.rank) - 1; d >= 0; d--) {
        uint idx = rest % p.shape[d];
        rest /= p.shape[d];
        ia += int(idx) * p.as_[d];
        ib += int(idx) * p.bs[d];
    }
    p.z.v[i] = binary_op(p.op, p.a.v[ia], p.b.v[ib]);
}
