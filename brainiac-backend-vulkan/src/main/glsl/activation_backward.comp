#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = GROUP) in;
#include "math.glsl"
layout(push_constant) uniform P { Floats x; Floats g; Floats y; uint n; uint op; float param; } p;
void main() {
    uint i = gid();
    if (i < p.n) p.y.v[i] = p.g.v[i] * activation_slope(p.op, p.param, p.x.v[i]);
}
