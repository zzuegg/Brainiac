#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// Fused scaled dot-product attention (Backend.attention), forward only: one work group per
// query row, taking the keys 256 at a time. Each invocation scores one key of a block; the
// block's maximum and sum come from shared-memory reductions; invocation d keeps output
// component d, rescaled online as the running maximum grows (as flash attention does).
// Computed in float32 whatever the format. An optional bias (masks) is added to the scores.
// With SPLIT (flash decoding), each row's keys are shared out in pieces of `chunk` among
// `parts` work groups, which write their unnormalized output, maximum and sum to `part`: a
// single query row then fills the device rather than one work group. The last piece of a row
// to finish (a counter per row) joins them, as attention_combine does, and resets the counter.
layout(local_size_x = GROUP) in;
#ifdef SPLIT
layout(buffer_reference, std430, buffer_reference_align = 4) coherent buffer Parts { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) coherent buffer Counters { uint v[]; };
shared bool lastPiece;
#endif
layout(push_constant) uniform P {
    In q; In k; In v; Buf z; Buf lse; In bias;
#ifdef SPLIT
    Parts part;
#endif
    uint heads; uint kvHeads; uint tq; uint tk; uint dk; uint dv; float scale; uint causal; uint rows;
    uint hasBias; uint sb; uint sh; uint si; uint sj;
#ifdef SPLIT
    Counters counters; uint parts; uint chunk;
#endif
} p;
shared float qs[GROUP];
shared float weights[GROUP];
shared float red[GROUP];

float reduceMax(float x, uint tid) {
    red[tid] = x;
    barrier();
    for (uint s = GROUP / 2; s > 0; s >>= 1) {
        if (tid < s) {
            red[tid] = max(red[tid], red[tid + s]);
        }
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

float reduceSum(float x, uint tid) {
    red[tid] = x;
    barrier();
    for (uint s = GROUP / 2; s > 0; s >>= 1) {
        if (tid < s) {
            red[tid] += red[tid + s];
        }
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

void main() {
    uint id = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
#ifdef SPLIT
    uint row = id / p.parts;
    uint piece = id % p.parts;
#else
    uint row = id;
#endif
    if (row >= p.rows) return;   // whole work groups: barriers stay uniform
    uint tid = gl_LocalInvocationID.x;
    uint i = row % p.tq;
    uint h = (row / p.tq) % p.heads;
    uint b = row / (p.tq * p.heads);
    uint kvh = h / (p.heads / p.kvHeads);
    uint kBase = (b * p.kvHeads + kvh) * p.tk * p.dk;
    uint vBase = (b * p.kvHeads + kvh) * p.tk * p.dv;
    if (tid < p.dk) {
        qs[tid] = float(LOAD(p.q, row * p.dk + tid));
    }
    barrier();
    int seen = p.causal != 0 ? clamp(int(i + p.tk) - int(p.tq) + 1, 0, int(p.tk)) : int(p.tk);
#ifdef SPLIT
    uint first = min(piece * p.chunk, uint(seen));
    uint last = min(first + p.chunk, uint(seen));
#else
    uint first = 0;
    uint last = uint(seen);
#endif
    float m = uintBitsToFloat(0xff800000u);
    float l = 0;
    float o = 0;
    for (uint c = first; c < last; c += GROUP) {
        uint j = c + tid;
        float s = uintBitsToFloat(0xff800000u);
        if (j < last) {
            float dot = 0;
            uint kr = kBase + j * p.dk;
            for (uint d = 0; d < p.dk; d++) {
                dot = fma(qs[d], float(LOAD(p.k, kr + d)), dot);
            }
            s = dot * p.scale;
            if (p.hasBias != 0) {
                s += float(LOAD(p.bias, b * p.sb + h * p.sh + i * p.si + j * p.sj));
            }
        }
        float mNew = max(m, reduceMax(s, tid));
        // a block masked to -inf throughout (a float16 bias cannot hold -1e9) adds nothing:
        // without the guards, exp(-inf - -inf) would make everything NaN
        float w = j < last && !isinf(s) ? exp(s - mNew) : 0.0;
        weights[tid] = w;
        float alpha = m == mNew ? 1.0 : exp(m - mNew);
        l = l * alpha + reduceSum(w, tid);   // its barriers also publish weights
        if (tid < p.dv) {
            float acc = o * alpha;
            uint n = min(uint(GROUP), last - c);
            uint vr = vBase + c * p.dv + tid;
            for (uint jj = 0; jj < n; jj++) {
                acc = fma(weights[jj], float(LOAD(p.v, vr + jj * p.dv)), acc);
            }
            o = acc;
        }
        m = mNew;
        barrier();   // weights are rewritten by the next block
    }
#ifdef SPLIT
    uint base = (row * p.parts + piece) * (p.dv + 2);
    if (tid < p.dv) {
        p.part.v[base + tid] = o;
    }
    if (tid == 0) {
        p.part.v[base + p.dv] = m;
        p.part.v[base + p.dv + 1] = l;
    }
    memoryBarrierBuffer();
    barrier();
    if (tid == 0) {
        uint done = atomicAdd(p.counters.v[row], 1u);
        lastPiece = done == p.parts - 1;
    }
    barrier();
    if (!lastPiece) {
        return;
    }
    memoryBarrierBuffer();
    uint stride = p.dv + 2;
    uint first0 = row * p.parts * stride;
    float mx = uintBitsToFloat(0xff800000u);
    for (uint t = 0; t < p.parts; t++) {
        mx = max(mx, p.part.v[first0 + t * stride + p.dv]);
    }
    float lt = 0;
    float ot = 0;
    for (uint t = 0; t < p.parts; t++) {
        float mi = p.part.v[first0 + t * stride + p.dv];
        float w = isinf(mi) && mi < 0 ? 0.0 : exp(mi - mx);
        lt += p.part.v[first0 + t * stride + p.dv + 1] * w;
        if (tid < p.dv) {
            ot += p.part.v[first0 + t * stride + tid] * w;
        }
    }
    if (tid < p.dv) {
        STORE(p.z, row * p.dv + tid, ACC(lt > 0 ? ot / lt : 0.0));
    }
    if (tid == 0) {
        STORE(p.lse, row, ACC(lt > 0 ? mx + log(lt) : uintBitsToFloat(0xff800000u)));
        p.counters.v[row] = 0u;   // ready for the next attention
    }
#else
    if (tid < p.dv) {
        STORE(p.z, row * p.dv + tid, ACC(l > 0 ? o / l : 0.0));
    }
    if (tid == 0) {
        STORE(p.lse, row, ACC(l > 0 ? m + log(l) : uintBitsToFloat(0xff800000u)));
    }
#endif
}
