#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// Joins the pieces of a split attention row (attention.comp with SPLIT): each piece's output
// and sum are rescaled to the largest maximum, added, and the output divided by the sum.
layout(local_size_x = GROUP) in;
layout(push_constant) uniform P {
    InFloats part; Buf z; Buf lse; uint parts; uint dv; uint rows;
} p;

void main() {
    uint row = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (row >= p.rows) return;
    uint tid = gl_LocalInvocationID.x;
    uint stride = p.dv + 2;
    uint base = row * p.parts * stride;
    float m = uintBitsToFloat(0xff800000u);
    for (uint i = 0; i < p.parts; i++) {
        m = max(m, p.part.v[base + i * stride + p.dv]);
    }
    float l = 0;
    float o = 0;
    for (uint i = 0; i < p.parts; i++) {
        float mi = p.part.v[base + i * stride + p.dv];
        float w = isinf(mi) && mi < 0 ? 0.0 : exp(mi - m);
        l += p.part.v[base + i * stride + p.dv + 1] * w;
        if (tid < p.dv) {
            o += p.part.v[base + i * stride + tid] * w;
        }
    }
    if (tid < p.dv) {
        STORE(p.z, row * p.dv + tid, ACC(l > 0 ? o / l : 0.0));
    }
    if (tid == 0) {
        STORE(p.lse, row, ACC(l > 0 ? m + log(l) : uintBitsToFloat(0xff800000u)));
    }
}
