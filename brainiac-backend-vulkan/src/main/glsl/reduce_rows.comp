#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = GROUP) in;
// Reductions along contiguous rows (inner 1): LANES invocations share each row, reading
// neighbouring values (one invocation per row would read with a stride of the row length),
// so a work group takes GROUP / LANES rows. op: 0 sum, 1 mean, 2 max, 3 min.
#define LANES 32
layout(push_constant) uniform P { In x; Buf y; uint rows; uint len; uint inner; uint op; } p;
shared ACC part[GROUP];
ACC combine(uint op, ACC a, ACC b) {
    if (op == 2) return isnan(a) || isnan(b) ? a + b : max(a, b);
    if (op == 3) return isnan(a) || isnan(b) ? a + b : min(a, b);
    return a + b;
}
void main() {
    uint lid = gl_LocalInvocationID.x;
    uint lane = lid % LANES;
    uint r = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * (GROUP / LANES) + lid / LANES;
    ACC acc = p.op == 2 ? NEG_INF : p.op == 3 ? POS_INF : K(0.0);
    if (r < p.rows) {
        uint base = r * p.len;
        for (uint t = lane; t < p.len; t += LANES) {
            acc = combine(p.op, acc, LOAD(p.x, base + t));
        }
    }
    part[lid] = acc;
    barrier();
    for (uint s = LANES / 2; s > 0; s >>= 1) {
        if (lane < s) part[lid] = combine(p.op, part[lid], part[lid + s]);
        barrier();
    }
    if (lane == 0 && r < p.rows) {
        STORE(p.y, r, p.op == 1 ? part[lid] / ACC(p.len) : part[lid]);
    }
}
