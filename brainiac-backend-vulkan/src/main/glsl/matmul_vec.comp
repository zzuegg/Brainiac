#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// z = a b for few rows of a (row-major [m, k]) and a row-major [k, n] matrix b: decoding's
// matrix-vector products, which read b once and are limited by memory bandwidth.
// Each invocation computes four adjacent columns, reading them as one vector when n is a
// multiple of 4, so neighbouring invocations read neighbouring memory. A work group covers
// 4 * QUADS columns with SLICES invocations per column quad, each over its own run of rows;
// the work group's z index picks a piece of `chunk` rows. Sums go to
// z[piece * m * n + ...], added up afterwards when there are several pieces.
// Compiled for ROWS = 1, 2, 4 and 8; rows past m repeat row 0 and are not stored.
#ifndef ROWS
#define ROWS 1
#endif
#define QUADS 32
#define SLICES 8
#if defined(TYPE_F64)
#define ACC4 dvec4
layout(buffer_reference, std430, buffer_reference_align = 32) restrict readonly buffer In4 { dvec4 v[]; };
#define LOAD4(b, i) (b.v[i])
#elif defined(TYPE_F16)
#define ACC4 vec4
layout(buffer_reference, std430, buffer_reference_align = 8) restrict readonly buffer In4 { f16vec4 v[]; };
#define LOAD4(b, i) vec4(b.v[i])
#elif defined(TYPE_BF16)
#define ACC4 vec4
layout(buffer_reference, std430, buffer_reference_align = 8) restrict readonly buffer In4 { u16vec4 v[]; };
vec4 bf16x4(u16vec4 h) {
    uvec4 u = uvec4(h) << 16;
    return uintBitsToFloat(u);
}
#define LOAD4(b, i) bf16x4(b.v[i])
#else
#define ACC4 vec4
layout(buffer_reference, std430, buffer_reference_align = 16) restrict readonly buffer In4 { vec4 v[]; };
#define LOAD4(b, i) (b.v[i])
#endif
layout(local_size_x = QUADS, local_size_y = SLICES) in;
layout(push_constant) uniform P {
    In a; In b; In4 b4; Buf z;
    uint m; uint k; uint n; uint chunk; uint vectors;
} p;
shared ACC4 sums[SLICES][QUADS];

// columns c .. c + 3 of row r (columns past n read as 0)
ACC4 columns(uint r, uint c, bool vectors) {
    uint i = r * p.n + c;
    if (vectors) {
        return LOAD4(p.b4, i >> 2);
    }
    ACC4 v = ACC4(0.0);
    for (uint j = 0; j < 4; j++) {
        if (c + j < p.n) v[j] = LOAD(p.b, i + j);
    }
    return v;
}

void main() {
    uint quad = gl_LocalInvocationID.x;
    uint slice = gl_LocalInvocationID.y;
    uint c = (gl_WorkGroupID.x * QUADS + quad) * 4;
    uint piece = gl_WorkGroupID.z;
    bool vectors = p.vectors != 0;
    uint from = piece * p.chunk;
    uint to = min(p.k, from + p.chunk);
    uint run = (to - from + SLICES - 1) / SLICES;
    uint start = min(to, from + slice * run);
    uint end = min(to, start + run);
    uint rowOf[ROWS];
    for (uint i = 0; i < ROWS; i++) {
        rowOf[i] = (i < p.m ? i : 0) * p.k;
    }
    ACC4 total[ROWS];
    for (uint i = 0; i < ROWS; i++) {
        total[i] = ACC4(0.0);
    }
    if (c < p.n) {
        for (uint r = start; r < end; r++) {
            ACC4 col = columns(r, c, vectors);
            for (uint i = 0; i < ROWS; i++) {
                total[i] = fma(ACC4(LOAD(p.a, rowOf[i] + r)), col, total[i]);
            }
        }
    }
    uint out0 = piece * p.m * p.n;
    for (uint i = 0; i < ROWS; i++) {
        sums[slice][quad] = total[i];
        barrier();
        if (slice == 0 && i < p.m && c < p.n) {
            ACC4 t = sums[0][quad];
            for (uint s = 1; s < SLICES; s++) {
                t += sums[s][quad];
            }
            uint o = out0 + i * p.n + c;
            for (uint j = 0; j < 4; j++) {
                if (c + j < p.n) STORE(p.z, o + j, t[j]);
            }
        }
        barrier();
    }
}
