#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = GROUP) in;
// table[pos * ks + k]: the image cell of kernel cell k at window position pos, or -1 for padding
layout(push_constant) uniform P {
    In x; InInts table; Floats z;
    uint channels; uint positions; uint ks; uint img; float pad; uint total;
} p;
void main() {
    uint idx = gid();
    if (idx >= p.total) return;
    uint width = p.channels * p.ks;
    uint row = idx / width;
    uint col = idx % width;
    uint nb = row / p.positions;
    uint pos = row % p.positions;
    uint ch = col / p.ks;
    uint k = col % p.ks;
    int cell = p.table.v[pos * p.ks + k];
    p.z.v[idx] = cell < 0 ? p.pad : p.x.v[(nb * p.channels + ch) * p.img + uint(cell)];
}
