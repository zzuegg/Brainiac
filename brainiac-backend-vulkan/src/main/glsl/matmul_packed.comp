#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "packed.glsl"
// z = a x packed, in a's and z's format, for up to ROWS rows of a (row-major [m, k]) and a packed [k, n] matrix.
// Each invocation computes four adjacent columns, reading their levels of a row as one
// 32-bit word when n is a multiple of 4, so neighbouring invocations read neighbouring
// words. A work group covers 4 * QUADS columns with SLICES invocations per column quad,
// each over its own run of rows; the work group's z index picks a piece of `chunk` rows.
// With several pieces, the last piece of each column group to finish adds them up (see Parts).
// Levels are summed per scale group and scaled once per group; with offsets != 0 each group
// also adds its offset times the sum of a over its rows.
// Compiled for ROWS = 1, 2, 4 and 8; rows past m repeat row 0 and are not stored.
#ifndef ROWS
#define ROWS 1
#endif
#define QUADS 32
#define SLICES 8
layout(local_size_x = QUADS, local_size_y = SLICES) in;
// with several pieces: each piece's sums, [piece, row, column quad], and a counter per
// column group that the last piece to finish finds, adds the pieces up and resets to 0
#if defined(TYPE_F64)
layout(buffer_reference, std430, buffer_reference_align = 32) coherent buffer Parts { dvec4 v[]; };
#else
layout(buffer_reference, std430, buffer_reference_align = 16) coherent buffer Parts { vec4 v[]; };
#endif
layout(buffer_reference, std430, buffer_reference_align = 4) coherent buffer Counters { uint v[]; };
shared bool lastPiece;
layout(push_constant) uniform P {
    In a; InWords q; InWords hi; InWords scaleCodes; InWords offsetCodes; InWords scales; InWords offsets; Buf z;
    Parts parts; Counters counters;
    uint m; uint k; uint n; uint group; uint flags; uint chunk; uint pieces; uint counter; uint perSuper; float shift;
} p;
shared ACC4 sums[SLICES][QUADS];
shared int table[16];
#include "packed_layout.glsl"

// adds row r's levels l of the four columns, times each row of a, to part (and a to sum)
#define ACCUMULATE(r, l) { ACC4 lv = (l); for (uint i = 0; i < ROWS; i++) { \
    ACC x = ACC(LOAD(p.a, rowOf[i] + (r))); part[i] = fma(ACC4(x), lv, part[i]); sum[i] += x; } }

// the levels of columns c .. c + 3 at row r (columns past n read as 0)
ACC4 levels(uint r, uint c, bool words) {
    if (words) {
        return ACC4(levels4At(r, c));
    }
    ACC4 v = ACC4(0.0);
    for (uint j = 0; j < 4; j++) {
        if (c + j < p.n) v[j] = ACC(levelAt(r, c + j));
    }
    return v;
}

// the super values (at i, a multiple of 4) and, with codes, the codes (at j) of four columns, multiplied
vec4 factors4(InWords supers, InWords codes, bool hasCodes, uint i, uint j) {
    vec4 v;
    if ((p.flags & 16u) != 0) {
        v = vec4(unpackHalf2x16(supers.v[i >> 1]), unpackHalf2x16(supers.v[(i >> 1) + 1]));
    } else {
        v = uintBitsToFloat(uvec4(supers.v[i], supers.v[i + 1], supers.v[i + 2], supers.v[i + 3]));
    }
    if (hasCodes) {
        int w = int(codes.v[j >> 2]);
        v *= vec4(bitfieldExtract(w, 0, 8), bitfieldExtract(w, 8, 8), bitfieldExtract(w, 16, 8), bitfieldExtract(w, 24, 8));
    }
    return v;
}

// the scales of group g in columns c .. c + 3
vec4 scales4(uint g, uint c, bool words) {
    if (words) {
        return factors4(p.scales, p.scaleCodes, (p.flags & 4u) != 0, (g / p.perSuper) * p.n + c, g * p.n + c);
    }
    vec4 v = vec4(0.0);
    for (uint j = 0; j < 4; j++) {
        if (c + j < p.n) v[j] = scaleAt(g, c + j);
    }
    return v;
}

vec4 offsets4(uint g, uint c, vec4 s, bool words) {
    if (words) {
        return factors4(p.offsets, p.offsetCodes, (p.flags & 8u) != 0, (g / p.perSuper) * p.n + c, g * p.n + c)
                + s * p.shift;
    }
    vec4 v = vec4(0.0);
    for (uint j = 0; j < 4; j++) {
        if (c + j < p.n) v[j] = offsetAt(g, c + j, s[j]);
    }
    return v;
}

void main() {
    uint quad = gl_LocalInvocationID.x;
    uint slice = gl_LocalInvocationID.y;
    uint c = (gl_WorkGroupID.x * QUADS + quad) * 4;
    uint piece = gl_WorkGroupID.z;
    bool words = p.n % 4 == 0;
    // rows [from, to) of this piece, cut into SLICES runs of an even number of rows
    uint from = piece * p.chunk;
    uint to = min(p.k, from + p.chunk);
    uint run = ((to - from + SLICES - 1) / SLICES + 1) & ~1u;
    uint start = min(to, from + slice * run);
    uint end = min(to, start + run);
    uint rowOf[ROWS];
    for (uint i = 0; i < ROWS; i++) {
        rowOf[i] = (i < p.m ? i : 0) * p.k;
    }
    ACC4 total[ROWS];
    for (uint i = 0; i < ROWS; i++) {
        total[i] = ACC4(0.0);
    }
    uint planeBits = (p.flags >> 8) & 15u;
    uint mode = (p.flags & 32u) != 0 ? 3u : planeBits != 0 ? 2u : (p.flags & 1u) != 0 ? 1u : 0u;
    int bias = 1 << (int((p.flags >> 12) & 15u) - 1);
    if (mode == 3u && quad < 16 && slice == 0) {
        table[quad] = tableAt(quad);
    }
    barrier();
    if (c < p.n) {
        uint r = start;
        while (r < end) {
            uint g = r / p.group;
            uint stop = min(end, (g + 1) * p.group);
            ACC4 part[ROWS];
            ACC sum[ROWS];
            for (uint i = 0; i < ROWS; i++) {
                part[i] = ACC4(0.0);
                sum[i] = ACC(0.0);
            }
            // a loop per layout, each reading a word of levels once for the rows it holds
            // (r and stop are even: groups and runs have an even number of rows)
            uint stride = p.n >> 2;   // words per row (per two rows with 4-bit levels)
            if (words && mode == 1u) {
                // two words of levels read before either is used, so more loads are in flight
                for (; r + 4 <= stop; r += 4) {
                    uint at = ((r >> 1) * p.n + c) >> 2;
                    int w = int(p.q.v[at]);
                    int v = int(p.q.v[at + stride]);
                    ACCUMULATE(r, ACC4(bitfieldExtract(w, 0, 4), bitfieldExtract(w, 8, 4),
                                       bitfieldExtract(w, 16, 4), bitfieldExtract(w, 24, 4)));
                    ACCUMULATE(r + 1, ACC4(bitfieldExtract(w, 4, 4), bitfieldExtract(w, 12, 4),
                                           bitfieldExtract(w, 20, 4), bitfieldExtract(w, 28, 4)));
                    ACCUMULATE(r + 2, ACC4(bitfieldExtract(v, 0, 4), bitfieldExtract(v, 8, 4),
                                           bitfieldExtract(v, 16, 4), bitfieldExtract(v, 24, 4)));
                    ACCUMULATE(r + 3, ACC4(bitfieldExtract(v, 4, 4), bitfieldExtract(v, 12, 4),
                                           bitfieldExtract(v, 20, 4), bitfieldExtract(v, 28, 4)));
                }
                for (; r < stop; r += 2) {
                    int w = int(p.q.v[((r >> 1) * p.n + c) >> 2]);
                    ACCUMULATE(r, ACC4(bitfieldExtract(w, 0, 4), bitfieldExtract(w, 8, 4),
                                       bitfieldExtract(w, 16, 4), bitfieldExtract(w, 24, 4)));
                    ACCUMULATE(r + 1, ACC4(bitfieldExtract(w, 4, 4), bitfieldExtract(w, 12, 4),
                                           bitfieldExtract(w, 20, 4), bitfieldExtract(w, 28, 4)));
                }
            } else if (words && mode == 2u) {
                uint perByte = 8u / planeBits;
                int pb = int(planeBits);
                for (; r < stop; r += 2) {
                    uint lw = p.q.v[((r >> 1) * p.n + c) >> 2];
                    uint hw = p.hi.v[((r / perByte) * p.n + c) >> 2];
                    int hs = int((r % perByte) * planeBits);
                    ivec4 u0 = ivec4(bitfieldExtract(lw, 0, 4) | (bitfieldExtract(hw, hs, pb) << 4),
                                     bitfieldExtract(lw, 8, 4) | (bitfieldExtract(hw, 8 + hs, pb) << 4),
                                     bitfieldExtract(lw, 16, 4) | (bitfieldExtract(hw, 16 + hs, pb) << 4),
                                     bitfieldExtract(lw, 24, 4) | (bitfieldExtract(hw, 24 + hs, pb) << 4));
                    hs += pb;
                    ivec4 u1 = ivec4(bitfieldExtract(lw, 4, 4) | (bitfieldExtract(hw, hs, pb) << 4),
                                     bitfieldExtract(lw, 12, 4) | (bitfieldExtract(hw, 8 + hs, pb) << 4),
                                     bitfieldExtract(lw, 20, 4) | (bitfieldExtract(hw, 16 + hs, pb) << 4),
                                     bitfieldExtract(lw, 28, 4) | (bitfieldExtract(hw, 24 + hs, pb) << 4));
                    ACCUMULATE(r, ACC4(u0 - bias));
                    ACCUMULATE(r + 1, ACC4(u1 - bias));
                }
            } else if (words && mode == 3u) {
                for (; r < stop; r += 2) {
                    uint w = p.q.v[((r >> 1) * p.n + c) >> 2];
                    ACCUMULATE(r, ACC4(table[bitfieldExtract(w, 0, 4)], table[bitfieldExtract(w, 8, 4)],
                                       table[bitfieldExtract(w, 16, 4)], table[bitfieldExtract(w, 24, 4)]));
                    ACCUMULATE(r + 1, ACC4(table[bitfieldExtract(w, 4, 4)], table[bitfieldExtract(w, 12, 4)],
                                           table[bitfieldExtract(w, 20, 4)], table[bitfieldExtract(w, 28, 4)]));
                }
            } else if (words) {
                // four rows' words read before any is used, so more loads are in flight
                for (; r + 4 <= stop; r += 4) {
                    uint at = (r * p.n + c) >> 2;
                    int w0 = int(p.q.v[at]);
                    int w1 = int(p.q.v[at + stride]);
                    int w2 = int(p.q.v[at + 2 * stride]);
                    int w3 = int(p.q.v[at + 3 * stride]);
                    ACCUMULATE(r, ACC4(bitfieldExtract(w0, 0, 8), bitfieldExtract(w0, 8, 8),
                                       bitfieldExtract(w0, 16, 8), bitfieldExtract(w0, 24, 8)));
                    ACCUMULATE(r + 1, ACC4(bitfieldExtract(w1, 0, 8), bitfieldExtract(w1, 8, 8),
                                           bitfieldExtract(w1, 16, 8), bitfieldExtract(w1, 24, 8)));
                    ACCUMULATE(r + 2, ACC4(bitfieldExtract(w2, 0, 8), bitfieldExtract(w2, 8, 8),
                                           bitfieldExtract(w2, 16, 8), bitfieldExtract(w2, 24, 8)));
                    ACCUMULATE(r + 3, ACC4(bitfieldExtract(w3, 0, 8), bitfieldExtract(w3, 8, 8),
                                           bitfieldExtract(w3, 16, 8), bitfieldExtract(w3, 24, 8)));
                }
                for (; r < stop; r++) {
                    int w = int(p.q.v[(r * p.n + c) >> 2]);
                    ACCUMULATE(r, ACC4(bitfieldExtract(w, 0, 8), bitfieldExtract(w, 8, 8),
                                       bitfieldExtract(w, 16, 8), bitfieldExtract(w, 24, 8)));
                }
            } else {
                for (; r < stop; r++) {
                    ACCUMULATE(r, levels(r, c, false));
                }
            }
            vec4 sf = scales4(g, c, words);
            ACC4 s = ACC4(sf);
            for (uint i = 0; i < ROWS; i++) {
                total[i] = fma(part[i], s, total[i]);
            }
            if ((p.flags & 2u) != 0) {
                ACC4 o = ACC4(offsets4(g, c, sf, words));
                for (uint i = 0; i < ROWS; i++) {
                    total[i] = fma(ACC4(sum[i]), o, total[i]);
                }
            }
        }
    }
    uint quads = (p.n + 3) / 4;
    for (uint i = 0; i < ROWS; i++) {
        sums[slice][quad] = total[i];
        barrier();
        if (slice == 0 && i < p.m && c < p.n) {
            ACC4 t = sums[0][quad];
            for (uint s = 1; s < SLICES; s++) {
                t += sums[s][quad];
            }
            if (p.pieces > 1) {
                p.parts.v[(piece * p.m + i) * quads + c / 4] = t;
            } else {
                uint o = i * p.n + c;
                for (uint j = 0; j < 4; j++) {
                    if (c + j < p.n) STORE(p.z, o + j, t[j]);
                }
            }
        }
        barrier();
    }
    if (p.pieces == 1) {
        return;
    }
    memoryBarrierBuffer();
    barrier();
    if (quad == 0 && slice == 0) {
        uint done = atomicAdd(p.counters.v[p.counter + gl_WorkGroupID.x], 1u);
        lastPiece = done == p.pieces - 1;
    }
    barrier();
    if (!lastPiece) {
        return;
    }
    memoryBarrierBuffer();
    if (slice == 0 && c < p.n) {
        for (uint i = 0; i < p.m; i++) {
            ACC4 t = ACC4(0.0);
            for (uint q = 0; q < p.pieces; q++) {
                t += p.parts.v[(q * p.m + i) * quads + c / 4];
            }
            uint o = i * p.n + c;
            for (uint j = 0; j < 4; j++) {
                if (c + j < p.n) STORE(p.z, o + j, t[j]);
            }
        }
    }
    if (quad == 0 && slice == 0) {
        p.counters.v[p.counter + gl_WorkGroupID.x] = 0u;   // ready for the next product
    }
}
