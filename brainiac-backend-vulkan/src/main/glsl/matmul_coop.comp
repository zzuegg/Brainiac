#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#include "common.glsl"
// matmul.comp on cooperative matrices (VK_KHR_cooperative_matrix), float16 only: the same
// push constants, batches and k pieces. Runs with subgroups of 32 (the pipeline requires
// them): 8 subgroups per work group compute a 128 x 128 tile, each a 32 x 64 block of
// 2 x 4 pieces of 16 x 16 with float32 sums, from float16 values staged in shared memory.
// With PACKED, b is a packed matrix (see packed_layout.glsl), staged from its levels.
#define BM 128
#define BN 128
#define BK 32
#define SA (BK + 8)      // shared row strides, padded against bank conflicts
#define SB (BN + 8)
layout(local_size_x = 256) in;
#ifdef PACKED
#include "packed.glsl"
layout(push_constant) uniform P {
    In a; InWords q; InWords hi; InWords scaleCodes; InWords offsetCodes; InWords scales; InWords offsets; Buf z;
    uint m; uint k; uint n; uint strideZ; uint splits; uint chunk; uint group; uint flags; uint perSuper; float shift;
} p;
#include "packed_layout.glsl"
#include "packed_tile.glsl"
shared vec2 factorsB[2][BN];
#else
layout(push_constant) uniform P {
    In a; In b; Buf z;
    uint m; uint k; uint n; uint strideA; uint strideB; uint strideZ; uint splits; uint chunk;
} p;
#endif
layout(buffer_reference, std430, buffer_reference_align = 8) restrict readonly buffer In4 { f16vec4 v[]; };
shared float16_t tileA[BM * SA];
shared float16_t tileB[BK * SB];
shared float scratch[8 * 256];   // one 16 x 16 piece per subgroup, for edge tiles

#define ACCM coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint colBase = gl_WorkGroupID.x * BN;
    uint rowBase = gl_WorkGroupID.y * BM;
    uint piece = gl_WorkGroupID.z;
    uint batch = piece / p.splits;
    uint from = (piece % p.splits) * p.chunk;
    uint to = min(p.k, from + p.chunk);
#ifdef PACKED
    uint aBase = 0;
    bool stage = staged(from, BK);
#else
    uint aBase = batch * p.strideA;
    uint bBase = batch * p.strideB;
#endif
    // vector loads where every run of 4 starts at a multiple of 4
    bool aligned = (p.k & 3u) == 0 && (p.n & 3u) == 0 && (from & 3u) == 0;
    uint sg = gl_SubgroupID;
    uint sr = sg >> 1;   // rows sr * 32 .. + 32
    uint sc = sg & 1u;   // columns sc * 64 .. + 64
    ACCM acc[2][4];
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 4; j++) {
            acc[i][j] = ACCM(0.0);
        }
    }
    for (uint t = from; t < to; t += BK) {
#ifdef PACKED
        if (stage) {
            factorsB[tid / BN][tid % BN] = stagedFactors(t, tid / BN, colBase + tid % BN);
            barrier();
        }
#endif
        // a: 128 x 32 as 1024 runs of 4; b: 32 x 128 likewise; 4 of each per invocation
        for (uint l = 0; l < 4; l++) {
            uint r4 = l * 256 + tid;
            uint row = r4 / (BK / 4);
            uint c = (r4 % (BK / 4)) * 4;
            uint gr = rowBase + row;
            uint gc = t + c;
            f16vec4 x = f16vec4(0);
            if (aligned && gr < p.m && gc + 3 < to) {
                x = In4(p.a).v[(aBase + gr * p.k + gc) >> 2];
            } else {
                for (uint e = 0; e < 4; e++) {
                    x[e] = gr < p.m && gc + e < to ? p.a.v[aBase + gr * p.k + gc + e] : float16_t(0);
                }
            }
            for (uint e = 0; e < 4; e++) {
                tileA[row * SA + c + e] = x[e];
            }
            uint br = r4 / (BN / 4);
            uint bc = (r4 % (BN / 4)) * 4;
            uint gbr = t + br;
            uint gbc = colBase + bc;
#ifdef PACKED
            f16vec4 y = f16vec4(0);
            if (gbr < to && stage) {
                uint i = gbr / p.group - t / p.group;
                if (gbc < p.n) {
                    vec2 f0 = factorsB[i][bc], f1 = factorsB[i][bc + 1], f2 = factorsB[i][bc + 2], f3 = factorsB[i][bc + 3];
                    y = f16vec4(vec4(levels4At(gbr, gbc)) * vec4(f0.x, f1.x, f2.x, f3.x) + vec4(f0.y, f1.y, f2.y, f3.y));
                }
            } else if (gbr < to) {
                y = f16vec4(packed4(gbr, gbc));
            }
#else
            f16vec4 y = f16vec4(0);
            if (aligned && gbr < to && gbc + 3 < p.n) {
                y = In4(p.b).v[(bBase + gbr * p.n + gbc) >> 2];
            } else {
                for (uint e = 0; e < 4; e++) {
                    y[e] = gbr < to && gbc + e < p.n ? p.b.v[bBase + gbr * p.n + gbc + e] : float16_t(0);
                }
            }
#endif
            for (uint e = 0; e < 4; e++) {
                tileB[br * SB + bc + e] = y[e];
            }
        }
        barrier();
        for (uint q = 0; q < BK; q += 16) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma[2];
            for (uint i = 0; i < 2; i++) {
                coopMatLoad(ma[i], tileA, (sr * 32 + i * 16) * SA + q, SA, gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint j = 0; j < 4; j++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb;
                coopMatLoad(mb, tileB, q * SB + sc * 64 + j * 16, SB, gl_CooperativeMatrixLayoutRowMajor);
                for (uint i = 0; i < 2; i++) {
                    acc[i][j] = coopMatMulAdd(ma[i], mb, acc[i][j]);
                }
            }
        }
        barrier();
    }
    uint zBase = piece * p.strideZ;
    bool whole = rowBase + BM <= p.m && colBase + BN <= p.n;
    for (uint i = 0; i < 2; i++) {
        for (uint j = 0; j < 4; j++) {
            uint row0 = rowBase + sr * 32 + i * 16;
            uint col0 = colBase + sc * 64 + j * 16;
            if (whole) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> h =
                        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc[i][j]);
                coopMatStore(h, p.z.v, zBase + row0 * p.n + col0, p.n, gl_CooperativeMatrixLayoutRowMajor);
            } else {
                coopMatStore(acc[i][j], scratch, sg * 256, 16, gl_CooperativeMatrixLayoutRowMajor);
                subgroupMemoryBarrierShared();
                subgroupBarrier();
                for (uint e = gl_SubgroupInvocationID; e < 256; e += gl_SubgroupSize) {
                    uint row = row0 + e / 16;
                    uint col = col0 + e % 16;
                    if (row < p.m && col < p.n) {
                        STORE(p.z, zBase + row * p.n + col, scratch[sg * 256 + e]);
                    }
                }
                subgroupBarrier();
            }
        }
    }
}
