#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#include "common.glsl"
// matmul.comp on cooperative matrices (VK_KHR_cooperative_matrix), float16 only: the same
// push constants, batches and k pieces. Runs with subgroups of 32 (the pipeline requires
// them): SGR x SGC subgroups per work group compute a BM x BN tile, each a block of TM x TN
// pieces of 16 x 16 with float32 sums, from float16 values staged in shared memory, BK
// values of k at a time. Compiled in several shapes, picked per device by VulkanBackend's
// tuning (default: 128 x 128 by 32, 4 x 2 subgroups of 2 x 4 pieces).
// With PACKED, b is a packed matrix (see packed_layout.glsl), staged from its levels.
#ifndef BM
#define BM 128
#endif
#ifndef BN
#define BN 128
#endif
#ifndef BK
#define BK 32
#endif
#ifndef SGR
#define SGR 4
#endif
#ifndef SGC
#define SGC 2
#endif
#ifndef PAD
#define PAD 8
#endif
#define TM (BM / SGR / 16)
#define TN (BN / SGC / 16)
#define LOCAL (32 * SGR * SGC)
#define SA (BK + PAD)      // shared row strides, padded against bank conflicts
#define SB (BN + PAD)
layout(local_size_x = LOCAL) in;
#ifdef PACKED
#include "packed.glsl"
layout(push_constant) uniform P {
    In a; InWords q; InWords hi; InWords scaleCodes; InWords offsetCodes; InWords scales; InWords offsets; Buf z;
    uint m; uint k; uint n; uint strideZ; uint splits; uint chunk; uint group; uint flags; uint perSuper; float shift;
} p;
#include "packed_layout.glsl"
#include "packed_tile.glsl"
shared vec2 factorsB[BK / 16][BN];   // groups of at least 16 rows: at most BK / 16 per step
#else
layout(push_constant) uniform P {
    In a; In b; Buf z;
    uint m; uint k; uint n; uint strideA; uint strideB; uint strideZ; uint splits; uint chunk;
} p;
#endif
layout(buffer_reference, std430, buffer_reference_align = 8) restrict readonly buffer In4 { f16vec4 v[]; };
#ifdef VEC
// staged four values at a time: one 8-byte store each instead of four 2-byte ones
shared f16vec4 tileA[BM * SA / 4];
shared f16vec4 tileB[BK * SB / 4];
#define V 4
#else
shared float16_t tileA[BM * SA];
shared float16_t tileB[BK * SB];
#define V 1
#endif
shared float scratch[SGR * SGC * 256];   // one 16 x 16 piece per subgroup, for edge tiles

#define ACCM coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint colBase = gl_WorkGroupID.x * BN;
    uint rowBase = gl_WorkGroupID.y * BM;
    uint piece = gl_WorkGroupID.z;
    uint batch = piece / p.splits;
    uint from = (piece % p.splits) * p.chunk;
    uint to = min(p.k, from + p.chunk);
#ifdef PACKED
    uint aBase = 0;
    bool stage = staged(from, BK);
#else
    uint aBase = batch * p.strideA;
    uint bBase = batch * p.strideB;
#endif
    // vector loads where every run of 4 starts at a multiple of 4
    bool aligned = (p.k & 3u) == 0 && (p.n & 3u) == 0 && (from & 3u) == 0;
    uint sg = gl_SubgroupID;
    uint sr = sg / SGC;   // rows sr * TM * 16 .. + TM * 16
    uint sc = sg % SGC;   // columns sc * TN * 16 .. + TN * 16
    ACCM acc[TM][TN];
    for (int i = 0; i < TM; i++) {
        for (int j = 0; j < TN; j++) {
            acc[i][j] = ACCM(0.0);
        }
    }
    for (uint t = from; t < to; t += BK) {
#ifdef PACKED
        if (stage) {
            for (uint e = tid; e < (BK / 16) * BN; e += LOCAL) {
                factorsB[e / BN][e % BN] = stagedFactors(t, e / BN, colBase + e % BN);
            }
            barrier();
        }
#endif
        // a: BM x BK as runs of 4 along k, b: BK x BN as runs of 4 along n
        for (uint r4 = tid; r4 < BM * BK / 4; r4 += LOCAL) {
            uint row = r4 / (BK / 4);
            uint c = (r4 % (BK / 4)) * 4;
            uint gr = rowBase + row;
            uint gc = t + c;
            f16vec4 x = f16vec4(0);
            if (aligned && gr < p.m && gc + 3 < to) {
                x = In4(p.a).v[(aBase + gr * p.k + gc) >> 2];
            } else {
                for (uint e = 0; e < 4; e++) {
                    x[e] = gr < p.m && gc + e < to ? p.a.v[aBase + gr * p.k + gc + e] : float16_t(0);
                }
            }
#ifdef VEC
            tileA[(row * SA + c) / 4] = x;
#else
            for (uint e = 0; e < 4; e++) {
                tileA[row * SA + c + e] = x[e];
            }
#endif
        }
        for (uint r4 = tid; r4 < BK * BN / 4; r4 += LOCAL) {
            uint br = r4 / (BN / 4);
            uint bc = (r4 % (BN / 4)) * 4;
            uint gbr = t + br;
            uint gbc = colBase + bc;
#ifdef PACKED
            f16vec4 y = f16vec4(0);
            if (gbr < to && stage) {
                uint i = gbr / p.group - t / p.group;
                if (gbc < p.n) {
                    vec2 f0 = factorsB[i][bc], f1 = factorsB[i][bc + 1], f2 = factorsB[i][bc + 2], f3 = factorsB[i][bc + 3];
                    y = f16vec4(vec4(levels4At(gbr, gbc)) * vec4(f0.x, f1.x, f2.x, f3.x) + vec4(f0.y, f1.y, f2.y, f3.y));
                }
            } else if (gbr < to) {
                y = f16vec4(packed4(gbr, gbc));
            }
#else
            f16vec4 y = f16vec4(0);
            if (aligned && gbr < to && gbc + 3 < p.n) {
                y = In4(p.b).v[(bBase + gbr * p.n + gbc) >> 2];
            } else {
                for (uint e = 0; e < 4; e++) {
                    y[e] = gbr < to && gbc + e < p.n ? p.b.v[bBase + gbr * p.n + gbc + e] : float16_t(0);
                }
            }
#endif
#ifdef VEC
            tileB[(br * SB + bc) / 4] = y;
#else
            for (uint e = 0; e < 4; e++) {
                tileB[br * SB + bc + e] = y[e];
            }
#endif
        }
        barrier();
        for (uint q = 0; q < BK; q += 16) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma[TM];
            for (uint i = 0; i < TM; i++) {
                coopMatLoad(ma[i], tileA, ((sr * TM * 16 + i * 16) * SA + q) / V, SA / V, gl_CooperativeMatrixLayoutRowMajor);
            }
            for (uint j = 0; j < TN; j++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb;
                coopMatLoad(mb, tileB, (q * SB + sc * TN * 16 + j * 16) / V, SB / V, gl_CooperativeMatrixLayoutRowMajor);
                for (uint i = 0; i < TM; i++) {
                    acc[i][j] = coopMatMulAdd(ma[i], mb, acc[i][j]);
                }
            }
        }
        barrier();
    }
    uint zBase = piece * p.strideZ;
    bool whole = rowBase + BM <= p.m && colBase + BN <= p.n;
    for (uint i = 0; i < TM; i++) {
        for (uint j = 0; j < TN; j++) {
            uint row0 = rowBase + sr * TM * 16 + i * 16;
            uint col0 = colBase + sc * TN * 16 + j * 16;
            if (whole) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> h =
                        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(acc[i][j]);
                coopMatStore(h, p.z.v, zBase + row0 * p.n + col0, p.n, gl_CooperativeMatrixLayoutRowMajor);
            } else {
                coopMatStore(acc[i][j], scratch, sg * 256, 16, gl_CooperativeMatrixLayoutRowMajor);
                subgroupMemoryBarrierShared();
                subgroupBarrier();
                for (uint e = gl_SubgroupInvocationID; e < 256; e += gl_SubgroupSize) {
                    uint row = row0 + e / 16;
                    uint col = col0 + e % 16;
                    if (row < p.m && col < p.n) {
                        STORE(p.z, zBase + row * p.n + col, scratch[sg * 256 + e]);
                    }
                }
                subgroupBarrier();
            }
        }
    }
}
